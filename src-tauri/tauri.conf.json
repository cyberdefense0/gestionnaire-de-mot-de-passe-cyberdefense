{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coffre",
  "version": "1.1.1",
  "identifier": "com.coffre.passwordmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Coffre — Gestionnaire de mots de passe",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBRTEyOEUxMTU0Mzk1MjgKUldRb2xVTVY0U2poZW1pckZiVzBGVjU2N0JqWTRJU0VkRXlkNXhNV0NQVHR3cUYxL1lpei9UZlEK",
      "endpoints": [
        "https://github.com/cyberdefense0/gestionnaire-de-mot-de-passe-cyberdefense/releases/latest/download/latest.json"
      ]
    }
  }
}
