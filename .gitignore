# ===============================
# Node / Frontend (tous les apps)
# ===============================
node_modules/
apps/*/node_modules/
packages/*/node_modules/

# Dist (build du frontend)
dist/
apps/*/dist/
apps/*/dist/

# ===============================
# Rust (vault-core, src-tauri, etc.)
# ===============================
target/
**/target/
**/*.rs.bk

# Tauri backend build
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/.tauri/

# ===============================
# Fichiers sensibles / données
# ===============================
*.vault
*.vault.attempts
*.key
*.pem
*.crt
*.der

# ===============================
# Logs
# ===============================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===============================
# OS & IDE
# ===============================
.DS_Store
Thumbs.db
desktop.ini

# Visual Studio Code
.vscode/
*.code-workspace

# IntelliJ / WebStorm / RustRover
.idea/
*.iml
*.iws

# Vim / Nano
*.swp
*.swo
*~

# ===============================
# Dependencies lock files (optionnel)
# ===============================
# Si tu veux versionner les lock files, commente les lignes ci-dessous :
# package-lock.json
# Cargo.lock
# yarn.lock
# pnpm-lock.yaml

# ===============================
# Environnement / secrets locaux
# ===============================
.env
.env.local
.env.*.local

# ===============================
# Fichiers de test / coverage
# ===============================
coverage/
.nyc_output/
*.test-results/

# ===============================
# Dossiers temporaires
# ===============================
tmp/
temp/
*.tmp
*.temp
